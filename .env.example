# 服务端专用配置（会被 server/env.mjs 读取）
# 注意：任何要保密的变量都不要加 VITE_ 前缀，Vite 会把 VITE_ 开头的变量内联进前端 bundle。

# 智谱 API Key：在 https://bigmodel.cn 创建，一个 key 可调所有模型，具体用哪个由 ZHIPU_MODEL 决定。
ZHIPU_API_KEY=your-zhipu-api-key

# OpenAI 兼容接口地址
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 模型 ID：glm-4-flash / glm-4.7-flash 为免费档；填付费模型时会消耗余额。
ZHIPU_MODEL=glm-4-flash

# 联网搜索（可选）：在 https://brave.com/search/api/ 创建 Brave Search API key。
# 不填则模型不会看到 web_search 工具；天气查询不需要这个 key。
# BRAVE_SEARCH_API_KEY=

# 入口防护（可选，仅 Vercel 的 /api/chat 生效）：
# 请求体上限（字节，默认 2097152 = 2MB）；每个 IP 每分钟最多请求次数（默认 20）。
# 注意：限流计数在函数实例内存里，多实例之间不共享，属于「尽力而为」。
# CHAT_MAX_BODY_BYTES=2097152
# CHAT_RATE_LIMIT_PER_MIN=20

# 后续接入「用户自带 key」时再启用，用于加密存储用户凭据。
# MODEL_KEY_ENCRYPTION_SECRET=
